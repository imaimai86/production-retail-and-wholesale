              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_id": {
                            "type": "integer"
                          },
                          "quantity": {
                            "type": "number"
                          },
                          "price": {
                            "type": "number"
                          },
                          "gst": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "number"
                    },
                    "gst": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Sale not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "tags": []
}