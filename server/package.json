{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --maxWorkers=4",
    "test:integration": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --testPathPattern=__tests__/integration/",
    "lint": "eslint .",
    "generate-spec": "cross-env NODE_ENV=development node scripts/generate-openapi-spec.js",
    "start:swagger": "node swaggerServer.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/integration/"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/pino-logging-gcp-config": "1.3.6",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "pg": "^8.11.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "pino-pretty": "13.2.0",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
