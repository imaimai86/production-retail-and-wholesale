# Copy to .env (in the repo root) and adjust. Never commit real credentials.
PORT=3000
ADMIN_TOKEN=change-me

# Local Postgres in Docker:
#   docker run -d --name prw-db -e POSTGRES_USER=app -e POSTGRES_PASSWORD=app \
#     -e POSTGRES_DB=app -p 5432:5432 -v prw-pgdata:/var/lib/postgresql/data postgres:16
# The server and script/migrate.sh read DATABASE_URL.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Fallback used by the server only when DATABASE_URL is unset or empty.
PGHOST=localhost
PGPORT=5432
PGUSER=app
PGPASSWORD=app
PGDATABASE=app

# SDLC model providers: the pipeline (ai-sdlc-helper) keeps them in a user-level registry, not in this file.
# Add one with: ai-sdlc-helper model add <provider> --endpoint <url> --key-env <VAR> --models a,b [--effort]
# (it stores the NAME of the variable holding the key; export that variable in your shell). See README.md.
# For CI and headless runs, ai-sdlc-helper still reads SDLC_PROVIDERS and SDLC_PROVIDER_<NAME>_ENDPOINT/_API_KEY/_MODELS/_EFFORT
# from this .env as a fallback; a provider in the registry wins over the same name here.
