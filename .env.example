# Copy to .env (in the repo root) and adjust. Never commit real credentials.
PORT=3000
ADMIN_TOKEN=change-me

# Local Postgres in Docker:
#   docker run -d --name prw-db -e POSTGRES_USER=app -e POSTGRES_PASSWORD=app \
#     -e POSTGRES_DB=app -p 5432:5432 -v prw-pgdata:/var/lib/postgresql/data postgres:16
# The server and script/migrate.sh read DATABASE_URL.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Fallback used by the server only when DATABASE_URL is unset or empty.
PGHOST=localhost
PGPORT=5432
PGUSER=app
PGPASSWORD=app
PGDATABASE=app

# SDLC model providers (read by scripts/sdlc.sh; only the SDLC_PROVIDER* keys are used).
# The primary place for providers is the user-level registry: bash scripts/sdlc-mod.sh model add ... (see README.md).
# It stores the NAME of the variable holding the key; export that variable in your shell, a value written here is not used for it.
# The block below is the fallback, for CI and headless runs. A provider in the registry wins over the same name here.
# Stages run through Claude Code. A model written "<provider>/<model>" (for example
#   MODEL_IMPLEMENT=openrouter/openai/gpt-5) runs against that provider's Anthropic-compatible endpoint
# (a gateway such as LiteLLM or OpenRouter). Models without a "/" are Anthropic models and need nothing here.
# SDLC_PROVIDERS=openrouter,local
# SDLC_PROVIDER_OPENROUTER_ENDPOINT=https://openrouter.ai/api
# SDLC_PROVIDER_OPENROUTER_API_KEY=change-me
# SDLC_PROVIDER_OPENROUTER_MODELS=openai/gpt-5,google/gemini-2.5-pro
# SDLC_PROVIDER_LOCAL_ENDPOINT=http://localhost:4000
# SDLC_PROVIDER_LOCAL_API_KEY=change-me
# SDLC_PROVIDER_LOCAL_MODELS=llama3:8b
# SDLC_PROVIDER_LOCAL_EFFORT=yes   # pass --effort to this provider (default: not passed)
