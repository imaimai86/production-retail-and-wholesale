{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // F5: starts the API under the debugger. Breakpoints work in server/**.
            // index.js loads the root .env itself (dotenv), so no envFile is needed here.
            "name": "Debug Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server/index.js",
            "cwd": "${workspaceFolder}/server",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/server/node_modules/**"
            ]
        },
        {
            // Attach to a server you already started, e.g. `node --inspect server/index.js`,
            // or to any running Node process chosen from the list.
            "name": "Attach to Server",
            "type": "node",
            "request": "attach",
            "processId": "${command:PickProcess}",
            "cwd": "${workspaceFolder}/server",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/server/node_modules/**"
            ]
        },
        {
            "name": "Launch Program (current file)",
            "type": "node",
            "request": "launch",
            "program": "${file}",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
